page{background:#F7F7F4;color:#1D1D1B;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif}.page{padding:32rpx 28rpx 48rpx}.hero{padding:24rpx 4rpx 42rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#8A8A82}.title{font-size:52rpx;font-weight:700;line-height:1.15;margin:18rpx 0}.subtitle{font-size:28rpx;line-height:1.6;color:#686860}.primary{margin:28rpx 0 0;background:#1D1D1B;color:#FFF;border-radius:18rpx;font-size:28rpx;font-weight:600}.section-title{font-size:34rpx;font-weight:700;margin:12rpx 0 20rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.card{background:#FFF;border-radius:24rpx;padding:18rpx;box-shadow:0 6rpx 24rpx rgba(20,20,18,.05)}.swatches{height:210rpx;border-radius:16rpx;overflow:hidden;display:flex;flex-direction:column}.swatch{flex:1}.card-name{font-size:30rpx;font-weight:600;margin-top:18rpx}.card-meta{font-size:20rpx;letter-spacing:2rpx;color:#999991;margin-top:6rpx}.panel{background:#FFF;border-radius:24rpx;padding:24rpx;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between}.muted{color:#77776F;font-size:24rpx}.small{font-size:22rpx}.input{background:#F1F1EC;border-radius:16rpx;padding:22rpx;margin:14rpx 0;font-size:30rpx}.code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.button{background:#1D1D1B;color:#FFF;border-radius:16rpx;font-size:28rpx}.outline{background:transparent;color:#1D1D1B;border:2rpx solid #D8D8D1}.color-preview{height:260rpx;border-radius:22rpx;margin-bottom:22rpx}.hscroll{white-space:nowrap}.mini-swatch{display:inline-block;width:110rpx;height:110rpx;border-radius:16rpx;margin-right:12rpx}.pro{background:#171714;color:#FFF}.pro .muted{color:#B8B8AE}.tag{padding:8rpx 14rpx;border-radius:999rpx;background:#ECECE7;font-size:20rpx}.ad-note{font-size:22rpx;color:#8A8A82;text-align:center;padding:18rpx 0}
