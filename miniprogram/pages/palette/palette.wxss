.page{padding:32rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.actions{margin-top:20rpx}.color-preview{height:320rpx;border-radius:28rpx;margin-bottom:24rpx}.hscroll{white-space:nowrap}.mini-swatch{display:inline-block;width:112rpx;height:112rpx;border-radius:20rpx;margin:16rpx 12rpx 0 0;box-sizing:border-box}.scale{display:flex;height:150rpx;border-radius:20rpx;overflow:hidden;margin-top:20rpx}.scale-item{flex:1;position:relative}.scale-item text{position:absolute;left:50%;bottom:12rpx;transform:translateX(-50%);font-size:18rpx;white-space:nowrap;writing-mode:vertical-rl}.input{box-sizing:border-box;width:100%;margin-top:20rpx;padding:20rpx;border:1px solid #DDD;border-radius:16rpx}.code{font-family:monospace}.outline{background:transparent;border:1px solid #CCC}.button{border-radius:16rpx}.panel{margin-top:24rpx;padding:28rpx;background:#FFF;border-radius:24rpx}.pro{background:#171714;color:#FFF}.muted{color:#777;margin-top:10rpx}.section-title{font-size:32rpx;font-weight:700}.title{font-size:48rpx;font-weight:800}.eyebrow{font-size:20rpx;letter-spacing:4rpx;font-weight:700}.tag{display:inline-block;padding:8rpx 14rpx;border-radius:999rpx;background:#FFF;color:#171714;font-size:18rpx;font-weight:700}