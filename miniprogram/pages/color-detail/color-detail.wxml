<view class="page" wx:if="{{item}}">
  <view class="hero compact"><view class="eyebrow">COLOR DETAIL</view><view class="title">{{item.name}}</view><view class="subtitle">{{item.collection}} · {{item.family}}</view></view>
  <view class="panel color-hero"><view class="big-swatch" style="background:{{item.hex}}"></view><view class="hex-title">{{item.hex}}</view><view class="source">{{item.source}}</view><view class="actions"><button class="primary" bindtap="useInStudio">用于创作</button><button class="secondary" bindtap="favorite">{{favorite?'已收藏':'收藏颜色'}}</button></view></view>
  <view class="panel"><view class="section-title">颜色数值</view><view class="value-row"><text>RGB</text><text>{{rgb.r}}, {{rgb.g}}, {{rgb.b}}</text><button data-type="rgb" bindtap="copyFormat">复制</button></view><view class="value-row"><text>HSL</text><text>{{hsl.h}}° · {{hsl.s}}% · {{hsl.l}}%</text><button data-type="hsl" bindtap="copyFormat">复制</button></view><view class="value-row"><text>OKLab</text><text>{{oklab.L.toFixed(4)}} · {{oklab.a.toFixed(4)}} · {{oklab.b.toFixed(4)}}</text><button data-type="oklab" bindtap="copyFormat">复制</button></view><view class="value-row"><text>OKLCH</text><text>{{oklch.L.toFixed(4)}} · {{oklch.C.toFixed(4)}} · {{oklch.H.toFixed(2)}}°</text><button data-type="oklch" bindtap="copyFormat">复制</button></view></view>
  <view class="panel"><view class="section-title">感知明度色阶</view><view class="scale"><view wx:for="{{palette}}" wx:key="*this" class="scale-item" style="background:{{item}}" data-value="{{item}}" bindtap="copy"><text>{{item}}</text></view></view><view class="muted tip">色阶使用 OKLab 的感知明度通道生成，适合做 UI 层级、背景和状态色。</view></view>
  <view class="panel"><view class="row"><view class="section-title">相近颜色</view><view class="muted">按 OKLab 距离</view></view><view class="related-grid"><view wx:for="{{related}}" wx:key="id" class="related" data-hex="{{item.hex}}" bindtap="openRelated"><view class="related-swatch" style="background:{{item.hex}}"></view><view class="related-name">{{item.name}}</view><view class="related-hex">{{item.hex}}</view></view></view></view>
  <view class="panel callout"><view class="section-title">从这个颜色开始</view><view class="muted">直接进入 Palette Studio，继续生成类似色、互补色、明暗色阶或自己的色卡。</view><button class="primary full" bindtap="makePalette">打开 Palette Studio</button></view>
</view>
