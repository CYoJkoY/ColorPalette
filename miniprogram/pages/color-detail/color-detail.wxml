<view class="page" wx:if="{{item}}">
  <view class="hero compact"><view class="eyebrow">COLOR DETAIL</view><view class="title">{{item.name}}</view><view class="subtitle">{{item.collection}} · {{item.family}}</view></view>
  <view class="panel color-hero"><view class="big-swatch" style="background:{{item.hex}}"></view><view class="hex-title">{{item.hex}}</view><view class="source">{{item.source}}</view><view class="actions"><button class="primary" bindtap="useInStudio">Use in Studio</button><button class="secondary" bindtap="favorite">{{favorite?'Saved':'Save color'}}</button></view></view>
  <view class="panel"><view class="section-title">Color values</view><view class="value-row"><text>RGB</text><text>{{rgb.r}}, {{rgb.g}}, {{rgb.b}}</text><button data-type="rgb" bindtap="copyFormat">Copy</button></view><view class="value-row"><text>HSL</text><text>{{hsl.h}}° · {{hsl.s}}% · {{hsl.l}}%</text><button data-type="hsl" bindtap="copyFormat">Copy</button></view><view class="value-row"><text>OKLab</text><text>{{labText}}</text><button data-type="oklab" bindtap="copyFormat">Copy</button></view><view class="value-row"><text>OKLCH</text><text>{{lchText}}</text><button data-type="oklch" bindtap="copyFormat">Copy</button></view></view>
  <view class="panel"><view class="section-title">Palette relationships</view><view class="muted section-note">每组关系都可以完整带入 Palette Studio，而不是只带入基础色。</view><view wx:for="{{relations}}" wx:key="id" class="relation"><view class="relation-head"><view><view class="relation-name">{{item.name}}</view><view class="relation-description">{{item.description}}</view></view><button class="relation-use" data-id="{{item.id}}" bindtap="useRelation">Use</button></view><view class="relation-swatches"><view wx:for="{{item.colors}}" wx:key="hex" class="relation-swatch" data-value="{{item.hex}}" bindtap="copy"><view class="relation-color" style="background:{{item.hex}}"></view><text>{{item.hex}}</text></view></view></view></view>
  <view class="panel"><view class="section-title">Perceptual lightness scale</view><view class="scale"><view wx:for="{{palette}}" wx:key="*this" class="scale-item" style="background:{{item}}" data-value="{{item}}" bindtap="copy"><text>{{item}}</text></view></view><view class="muted tip">The scale uses OKLab lightness to create a more perceptually coherent ramp for UI layers, backgrounds, and states.</view></view>
  <view class="panel"><view class="section-title">Contrast check</view><view class="contrast-grid"><view wx:for="{{contrast}}" wx:key="label" class="contrast-card" style="background:{{item.background}}"><view class="contrast-label">{{item.label}}</view><view class="contrast-value" style="color:{{item.background==='#FFFFFF'?'#111111':'#FFFFFF'}}">{{item.ratio}}:1</view><view class="contrast-grade" style="color:{{item.background==='#FFFFFF'?'#666666':'#DDDDDD'}}">{{item.grade}}</view></view></view><view class="muted tip">Contrast ratios follow the WCAG relative-luminance formula.</view></view>
  <view class="panel"><view class="row"><view class="section-title">Nearby colors</view><view class="muted">OKLab distance</view></view><view class="related-grid"><view wx:for="{{related}}" wx:key="id" class="related" data-hex="{{item.hex}}" bindtap="openRelated"><view class="related-swatch" style="background:{{item.hex}}"></view><view class="related-name">{{item.name}}</view><view class="related-hex">{{item.hex}}</view></view></view></view>
  <view class="panel callout"><view class="section-title">Continue with this color</view><view class="muted">Take this color into Palette Studio to refine it, combine it with named colors, and save a complete palette.</view><button class="primary full" bindtap="makePalette">Open Palette Studio</button></view>
</view>
