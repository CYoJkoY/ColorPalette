.color-hero{text-align:center}.big-swatch{height:360rpx;border-radius:28rpx}.hex-title{font-size:42rpx;font-weight:800;margin-top:24rpx}.source{font-size:21rpx;color:#777;margin-top:8rpx}.actions{display:flex;gap:14rpx;margin-top:24rpx}.actions button{flex:1}.secondary{background:#F0F0EC;color:#1D1D1B}.value-row{display:grid;grid-template-columns:90rpx 1fr 90rpx;align-items:center;gap:12rpx;padding:20rpx 0;border-bottom:1rpx solid #E8E8E3;font-size:23rpx}.value-row:last-child{border-bottom:0}.value-row text:nth-child(2){font-family:monospace;text-align:right}.value-row button{margin:0;padding:0;line-height:48rpx;font-size:20rpx;background:#F0F0EC;color:#1D1D1B}.scale{display:grid;grid-template-columns:repeat(9,1fr);gap:6rpx;margin-top:18rpx}.scale-item{height:120rpx;border-radius:9rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:8rpx;box-sizing:border-box}.scale-item text{font-size:15rpx;color:#fff;text-shadow:0 1rpx 3rpx #000}.tip{display:block;margin-top:14rpx;line-height:1.6}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:16rpx}.related{background:#F7F7F4;border-radius:14rpx;padding:10rpx}.related-swatch{height:120rpx;border-radius:10rpx}.related-name{font-size:21rpx;font-weight:700;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.related-hex{font-size:18rpx;color:#777;margin-top:3rpx}.full{width:100%;margin-top:18rpx}