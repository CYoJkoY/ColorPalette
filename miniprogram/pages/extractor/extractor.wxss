.hero{padding-bottom:26rpx}.grid{grid-template-columns:1fr 1fr}.panel{overflow:hidden}.picked-row{display:flex;align-items:center;gap:16rpx;margin:18rpx 0;padding:16rpx;background:#F4F4F0;border-radius:16rpx}.picked-dot{width:72rpx;height:72rpx;border-radius:14rpx;flex:none}.picked-info{flex:1;min-width:0}.mini-button{margin:0;background:#1D1D1B;color:#fff;font-size:22rpx;line-height:64rpx;border-radius:12rpx;padding:0 20rpx}.color-card{background:#fff;border-radius:14rpx;padding:12rpx;box-sizing:border-box}.tip{display:block;margin-top:18rpx;line-height:1.5}
