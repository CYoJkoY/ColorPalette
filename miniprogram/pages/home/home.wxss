.page{min-height:100vh}.hero{padding-top:8rpx}.grid{grid-template-columns:1fr 1fr}.card{min-width:0}.hero-actions{display:flex;gap:14rpx}.hero-actions button{flex:1}.secondary{background:#EFEFEB;color:#1D1D1B}.library-entry{width:100%;margin-top:16rpx;padding:20rpx 22rpx;background:#1D1D1B;color:#fff;border-radius:18rpx;display:flex;justify-content:space-between;align-items:center;text-align:left}.library-entry-title{font-size:27rpx;font-weight:700}.library-entry-sub{font-size:20rpx;color:#D4D4D0;margin-top:5rpx}.library-entry text{font-size:38rpx;font-weight:300}.workflow{margin-top:28rpx}.step{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1px solid #ECECE6}.step:last-child{border-bottom:0}.step-no{width:58rpx;height:58rpx;border-radius:50%;background:#1D1D1B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx;flex:none}.step-title{font-weight:700;margin-bottom:4rpx}