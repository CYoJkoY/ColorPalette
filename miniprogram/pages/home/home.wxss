.page{min-height:100vh}.hero{padding-top:8rpx}.grid{grid-template-columns:1fr 1fr}.card{min-width:0}.hero-actions{display:flex;gap:14rpx}.hero-actions button{flex:1}.secondary{background:#EFEFEB;color:#1D1D1B}.workflow{margin-top:28rpx}.step{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1px solid #ECECE6}.step:last-child{border-bottom:0}.step-no{width:58rpx;height:58rpx;border-radius:50%;background:#1D1D1B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx;flex:none}.step-title{font-weight:700;margin-bottom:4rpx}
