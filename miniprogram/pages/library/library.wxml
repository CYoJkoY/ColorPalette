<view class="page"><view class="hero compact"><view class="eyebrow">COLOR LIBRARY</view><view class="title">颜色百科</view><view class="subtitle">按色彩体系、色相和名称快速定位颜色；点色块查看完整参数、相近颜色与色阶。</view></view><view class="panel filters"><view class="filter-label">色彩体系</view><scroll-view scroll-x class="chips"><view wx:for="{{collections}}" wx:key="*this" class="chip {{collectionIndex===index?'active':''}}" data-index="{{index}}" bindtap="onCollectionTap">{{item}}</view></scroll-view><view class="filter-label second">色相分类</view><scroll-view scroll-x class="chips"><view wx:for="{{families}}" wx:key="*this" class="chip {{familyIndex===index?'active':''}}" data-index="{{index}}" bindtap="onFamilyTap">{{item}}</view></scroll-view><view class="search-wrap"><text class="search-icon">⌕</text><input class="search-input" placeholder="搜索名称、英文名或 HEX" value="{{query}}" bindinput="inputSearch" /></view></view><view class="result-head"><view class="section-title">{{total}} 个颜色</view><view class="muted">点击色块查看详情</view></view><view class="library-grid"><view wx:for="{{results}}" wx:key="id" class="library-card"><view class="swatch" style="background:{{item.hex}}" data-hex="{{item.hex}}" bindtap="openDetail"></view><view class="library-info"><view class="library-name">{{item.name}}</view><view class="library-meta"><text>{{item.hex}}</text><text>{{item.family}}</text></view><view class="library-source">{{item.collection}}</view><view class="library-actions"><button class="copy" data-hex="{{item.hex}}" bindtap="copy">复制</button><button class="use" data-hex="{{item.hex}}" bindtap="useColor">用于创作</button></view></view></view></view></view>
