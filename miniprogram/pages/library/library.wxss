.compact{padding-bottom:14rpx}.filters{margin-bottom:22rpx}.filter-label{font-size:22rpx;font-weight:700;color:#55554F}.filter-label.second{margin-top:22rpx}.chips{white-space:nowrap;margin-top:12rpx;width:100%}.chip{display:inline-block;padding:12rpx 22rpx;margin-right:10rpx;border-radius:999rpx;background:#F0F0EC;color:#66665F;font-size:22rpx}.chip.active{background:#1D1D1B;color:#fff}.search-wrap{display:flex;align-items:center;background:#F4F4F0;border-radius:16rpx;margin-top:18rpx;padding:0 18rpx}.search-icon{font-size:36rpx;color:#777}.search-input{flex:1;padding:20rpx 12rpx;font-size:24rpx}.result-head{display:flex;justify-content:space-between;align-items:center;margin:4rpx 0 14rpx}.library-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.library-card{background:#fff;border:1rpx solid #ECECE7;border-radius:18rpx;overflow:hidden;box-shadow:0 4rpx 18rpx rgba(0,0,0,.03)}.swatch{height:190rpx}.library-info{padding:16rpx}.library-name{font-size:25rpx;font-weight:700;line-height:1.35;min-height:68rpx}.library-meta{display:flex;justify-content:space-between;gap:8rpx;font-size:19rpx;color:#666;margin-top:8rpx}.library-source{font-size:18rpx;color:#999;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.library-actions{display:flex;gap:8rpx;margin-top:14rpx}.library-actions button{flex:1;margin:0;padding:0;line-height:54rpx;font-size:20rpx;border-radius:10rpx}.copy{background:#F0F0EC;color:#333}.use{background:#1D1D1B;color:#fff}@media (max-width:360px){.library-grid{grid-template-columns:1fr}}