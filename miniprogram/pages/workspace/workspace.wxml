<view class="page">
  <view class="hero"><text class="eyebrow">WORKSPACE</text><text class="title">My color workspace</text><text class="sub">Saved palettes, colors, and recent work in one place.</text></view>
  <view class="search"><input value="{{query}}" placeholder="Search palettes or HEX" bindinput="inputSearch" confirm-type="search" /></view>
  <view class="tabs"><view class="tab {{tab === 'palettes' ? 'active' : ''}}" data-tab="palettes" bindtap="switchTab">Palettes</view><view class="tab {{tab === 'colors' ? 'active' : ''}}" data-tab="colors" bindtap="switchTab">Colors</view><view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">Recent</view></view>

  <view wx:if="{{tab === 'palettes'}}" class="section">
    <view wx:if="{{!palettes.length}}" class="empty"><text>No saved palettes yet.</text><text class="muted">Create a palette and save it here.</text></view>
    <view wx:for="{{palettes}}" wx:key="id" class="palette-card">
      <view class="palette-main" data-palette="{{item}}" bindtap="openPalette">
        <view class="swatches"><view wx:for="{{item.colors}}" wx:key="*this" class="swatch" style="background:{{item}}"></view></view>
        <view class="palette-info"><text class="palette-name">{{item.name}}</text><text class="muted">{{item.colors.length}} colors · {{item.source}}</text></view>
      </view>
      <view class="palette-actions"><text class="action" data-id="{{item.id}}" bindtap="duplicatePalette">Duplicate</text><text class="action danger" data-id="{{item.id}}" bindtap="deletePalette">Delete</text></view>
    </view>
  </view>

  <view wx:if="{{tab === 'colors'}}" class="section grid">
    <view wx:if="{{!colors.length}}" class="empty"><text>No saved colors yet.</text></view>
    <view wx:for="{{colors}}" wx:key="hex" class="color-card" data-hex="{{item.hex}}" bindtap="openColor"><view class="color-preview" style="background:{{item.hex}}"></view><text>{{item.name || 'Custom color'}}</text><text class="muted">{{item.hex}}</text></view>
  </view>

  <view wx:if="{{tab === 'history'}}" class="section">
    <view class="history-head"><text class="section-title">Recent activity</text><text wx:if="{{history.length}}" class="clear" bindtap="clearHistory">Clear</text></view>
    <view wx:if="{{!history.length}}" class="empty"><text>No recent activity.</text></view>
    <view wx:for="{{history}}" wx:key="key" class="history-item"><view wx:if="{{item.type === 'color'}}" class="history-dot" style="background:{{item.hex}}"></view><view wx:else class="history-palette"><view wx:for="{{item.colors}}" wx:key="*this" class="mini" style="background:{{item}}"></view></view><view class="history-copy"><text>{{item.name || item.hex}}</text><text class="muted">{{item.type === 'color' ? item.hex : item.colors.length + ' colors'}}</text></view></view>
  </view>
</view>
