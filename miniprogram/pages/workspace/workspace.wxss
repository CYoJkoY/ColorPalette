.page{min-height:100vh;background:#F7F7F4;padding:32rpx;box-sizing:border-box;color:#18181B}.hero{padding:18rpx 4rpx 28rpx}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#71717A}.title{display:block;font-size:48rpx;font-weight:700;margin-top:12rpx}.sub,.muted{display:block;color:#71717A;font-size:24rpx;margin-top:8rpx}.tabs{display:flex;background:#EAEAE5;border-radius:18rpx;padding:6rpx;margin-bottom:24rpx}.tab{flex:1;text-align:center;padding:18rpx 0;border-radius:14rpx;font-size:26rpx}.tab.active{background:#FFF;font-weight:600}.section{display:flex;flex-direction:column;gap:18rpx}.palette-card,.color-card,.history-item{background:#FFF;border:1rpx solid #E4E4DF;border-radius:22rpx;padding:20rpx;box-sizing:border-box}.palette-card{position:relative}.swatches{display:flex;height:120rpx;border-radius:14rpx;overflow:hidden}.swatch{flex:1}.palette-info{padding-top:16rpx}.palette-name{font-size:30rpx;font-weight:600}.delete{position:absolute;right:20rpx;bottom:20rpx;color:#A1A1AA;font-size:22rpx}.grid{display:grid;grid-template-columns:1fr 1fr;align-items:start}.color-card{display:flex;flex-direction:column}.color-preview{height:180rpx;border-radius:14rpx;margin-bottom:14rpx}.history-head{display:flex;justify-content:space-between;align-items:center}.section-title{font-size:28rpx;font-weight:600}.clear{font-size:24rpx;color:#71717A}.history-item{display:flex;align-items:center;gap:18rpx}.history-dot{width:72rpx;height:72rpx;border-radius:50%;flex:none}.history-palette{width:72rpx;height:72rpx;border-radius:12rpx;overflow:hidden;display:flex;flex-wrap:wrap;flex:none}.mini{width:50%;height:50%}.history-copy{flex:1}.empty{background:#FFF;border:1rpx dashed #D4D4D0;border-radius:22rpx;padding:48rpx 28rpx;text-align:center}.empty .muted{margin-top:12rpx}