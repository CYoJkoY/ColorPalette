<view class="page">
  <view class="hero"><view class="eyebrow">PALETTE STUDIO</view><view class="title">自己做一张色卡</view><view class="subtitle">从基础色、颜色库或图片取色开始，再选择配色逻辑并微调。你可以把结果收藏成自己的色卡。</view></view>

  <view class="panel">
    <view class="section-title">基础颜色</view>
    <view class="base-color" style="background:{{hex}}"></view>
    <view class="hex-row"><input class="hex-input" value="{{hex}}" maxlength="7" bindconfirm="inputHex" confirm-type="done" /><button class="mini-button" data-hex="{{hex}}" bindtap="copy">复制</button></view>
    <view class="slider-row"><text>色相</text><slider data-key="h" value="{{h}}" min="0" max="359" activeColor="#1D1D1B" bindchange="onSliderChange" /></view>
    <view class="slider-row"><text>饱和度</text><slider data-key="s" value="{{s}}" min="0" max="100" activeColor="#1D1D1B" bindchange="onSliderChange" /></view>
    <view class="slider-row"><text>明度</text><slider data-key="l" value="{{l}}" min="0" max="100" activeColor="#1D1D1B" bindchange="onSliderChange" /></view>
  </view>

  <view class="panel">
    <view class="row"><view class="section-title">颜色库</view><view class="muted">60 个精选颜色</view></view>
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="picker">{{categories[categoryIndex]}} <text>切换颜色类别 ›</text></view></picker>
    <view class="library-grid"><view wx:for="{{library}}" wx:key="hex" class="library-item" data-hex="{{item.hex}}" bindtap="selectLibraryColor"><view class="library-dot" style="background:{{item.hex}}"></view><view class="library-name">{{item.name}}</view><view class="library-hex">{{item.hex}}</view></view></view>
  </view>

  <view class="panel">
    <view class="section-title">配色方式</view>
    <picker mode="selector" range="{{modes}}" range-key="name" value="{{modeIndex}}" bindchange="onModeChange"><view class="picker">{{modes[modeIndex].name}} <text>选择配色逻辑 ›</text></view></picker>
  </view>

  <view class="panel palette-panel">
    <view class="row"><view class="section-title">生成结果</view><view class="muted">{{colors.length}} 色</view></view>
    <view class="swatches"><view wx:for="{{colors}}" wx:key="*this" class="swatch" data-hex="{{item}}" bindtap="copy"><view class="swatch-color" style="background:{{item}}"></view><view class="code">{{item}}</view></view></view>
    <view class="actions"><button class="primary" bindtap="save">{{saved?'已收藏':'收藏这张色卡'}}</button><button class="secondary" bindtap="addColor">加入当前色</button></view>
    <view class="muted tip">点选颜色库会把它设为基础色；“加入当前色”则会把它作为一个独立色块加入当前色卡。</view>
  </view>
</view>
