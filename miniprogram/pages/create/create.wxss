.hero{padding-bottom:24rpx}.base-color{height:180rpx;border-radius:22rpx;margin:18rpx 0}.hex-row{display:flex;gap:14rpx;align-items:center}.hex-input{flex:1;background:#F4F4F0;border-radius:14rpx;padding:20rpx;font-size:30rpx;font-weight:700}.mini-button{margin:0;padding:0 24rpx;font-size:24rpx;line-height:70rpx;background:#1D1D1B;color:#fff;border-radius:14rpx}.slider-row{display:flex;align-items:center;margin-top:20rpx}.slider-row text{width:90rpx;font-size:24rpx;color:#666}.slider-row slider{flex:1}.picker{display:flex;justify-content:space-between;align-items:center;padding:24rpx;background:#F4F4F0;border-radius:16rpx;font-weight:700}.picker text{font-size:22rpx;color:#777;font-weight:400}.swatches{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx;margin-top:16rpx}.swatch{min-width:0}.swatch-color{height:150rpx;border-radius:14rpx 14rpx 8rpx 8rpx}.code{font-size:20rpx;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.actions{display:flex;gap:14rpx;margin-top:22rpx}.actions button{flex:1}.secondary{background:#F0F0EC;color:#1D1D1B}.hint{color:#777;font-size:23rpx;line-height:1.6}
