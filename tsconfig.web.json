{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "moduleResolution": "Classic",
    "rootDir": "web",
    "outDir": "web-dist",
    "strict": false,
    "noImplicitAny": false,
    "noCheck": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "files": [
    "web/globals.d.ts",
    "web/locales/zh-CN.ts",
    "web/locales/en-US.ts",
    "web/i18n.ts",
    "web/ui-shell.ts",
    "web/preferences-lite.ts",
    "web/app-locale.ts",
    "web/library-pagination.ts",
    "web/palette-studio-controls.ts",
    "web/ui-motion.ts",
    "web/favorites-workspace.ts"
  ]
}
